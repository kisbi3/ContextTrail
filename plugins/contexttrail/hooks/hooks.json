{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v contexttrail >/dev/null 2>&1 && contexttrail auto-update || true",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v contexttrail >/dev/null 2>&1 && contexttrail note --hook || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
